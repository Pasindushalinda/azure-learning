  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Threading.ExecutionContext" Alias="ExecutionContext" />
  </ItemGroup>

  <!-- The func host ships System.Memory.Data v1.x but the Durable extension's Azure.Core needs v8.0.0.1.
       Force the net8.0 build of System.Memory.Data 8.0.1 into .azurefunctions so the host can resolve it. -->
  <!-- The func host ships System.Memory.Data v1.x but the Durable extension's Azure.Core needs v8.0.0.1.
       Force the net8.0 build of System.Memory.Data 8.0.1 into .azurefunctions so the host can resolve it. -->
  <Target Name="CopySystemMemoryDataToAzureFunctions" AfterTargets="Build">
    <PropertyGroup>
      <_SmdDll>$(HOME)/.nuget/packages/system.memory.data/8.0.1/lib/net8.0/System.Memory.Data.dll</_SmdDll>
      <_AzFuncDir>$([System.IO.Path]::Combine('$(OutputPath)', '.azurefunctions'))</_AzFuncDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_SmdDll)"
          DestinationFolder="$(_AzFuncDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_SmdDll)') And Exists('$(_AzFuncDir)')" />
  </Target>
</Project>